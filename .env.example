# Copia a .env (ignorado por git). wrangler lo lee solo.
# Token de API creado en la cuenta de Cloudflare donde vive la zona yanes.me, con permisos:
#   Account > Workers Scripts: Edit · Zone > Workers Routes: Edit · Zone > DNS: Edit · Zone > Zone: Read
CLOUDFLARE_API_TOKEN=
# Account ID de esa misma cuenta (panel de Cloudflare, barra lateral del dominio).
CLOUDFLARE_ACCOUNT_ID=
