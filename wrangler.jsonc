{
  // Publicacion en Cloudflare: Worker con estaticos (lo que hoy es Cloudflare Pages). `make publicar`.
  // La cuenta y el token salen de .env (ver .env.example): la zona yanes.me vive en la cuenta personal de Juan.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teclea",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  // URL de respaldo mientras el dominio propio no resuelve: https://teclea.teclea.workers.dev
  "workers_dev": true,
  "assets": { "directory": "sitio", "not_found_handling": "404-page" },
  // teclea.yanes.me: ruta de zona. Necesita un registro DNS proxied para ese nombre (AAAA 100::),
  // porque la creacion automatica de DNS de los "custom domains" no funciono en esta zona (2026-10-08).
  "routes": [{ "pattern": "teclea.yanes.me/*", "zone_name": "yanes.me" }]
}
